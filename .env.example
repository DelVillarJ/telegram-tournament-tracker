# ===========================================
# Telegram Bot - TopDeck Tournament Tracker
# Environment Configuration Template
# ===========================================

# =========================================
# TELEGRAM BOT CONFIGURATION
# Get token from @BotFather on Telegram
# =========================================
BOT_TOKEN=your_bot_token_from_btfather_here

# =========================================
# TOPDECK API CONFIGURATION
# =========================================
TOPDECK_API_URL=https://api.topdeck.gg/v2
TOPDECK_CLIENT_ID=your_client_id_here
TOPDECK_CLIENT_SECRET=your_client_secret_here
TOPDECK_REDIRECT_URI=http://localhost:8000/callback

# =========================================
# TOURNAMENT TRACKING CONFIGURATION
# Comma-separated list of user IDs to track tournaments from
# =========================================
TARGET_USER_ID=user_id_1,user_id_2,user_id_3

# Time in seconds between API polling (default: 60)
TOPDECK_POLL_INTERVAL=60

# =========================================
# BOT BEHAVIOR CONFIGURATION
# =========================================
NOTIFY_ON_COMPLETE=true    # Send notification when tournaments complete
AUTO_UPDATE_STANDINGS=true # Auto-update standings after events
DEBUG=false                # Enable debug logging for development

# =========================================
# DATABASE CONFIGURATION
# Using SQLite as specified
# =========================================
DATABASE_PATH=data/tournaments.db
DB_USE_SQLITE=true

# =========================================
# PERFORMANCE & CACHING
# Optional: Use in-memory cache for API responses
# =========================================
CACHE_ENABLED=false        # Disable by default to avoid complexity
CACHE_TTL=60               # Cache time-to-live in seconds (unused if CACHE_ENABLED=false)

# =========================================
# LOGGING CONFIGURATION
# =========================================
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=plain           # plain or json
LOG_FILE=logs/bot.log      # Optional log file path (default: console only)

# =========================================
# SECURITY
# =========================================
API_CALL_RETRIES=3         # Number of retry attempts for failed API calls
API_CALL_TIMEOUT=30        # Seconds before considering request timed out
ENCRYPT_SECRETS=true       # Whether to encrypt secrets in database (future feature)
