# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# TopDeck Tournaments V2 API
TOPDECK_API_URL=https://topdeck.gg/api
TOPDECK_API_KEY=your_topdeck_api_key_here
TOPDECK_WEBHOOK_SECRET=
TOPDECK_DEFAULT_CHAT_ID=<TelgramchatID>
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_BIND_ADDRESS=0.0.0.0

# Comma-separated Telegram accounts bootstrapped as bot admins
BONUS_ADMIN_IDS=
BONUS_ADMIN_USERNAMES=

# Local SQLite file; Docker Compose overrides this with /app/data/tournaments.db
DATABASE_PATH=data/tournaments.db

# Optional debug logging
DEBUG=false
