{
  "name": "ollama-local-agent",
  "description": "Local AI agent powered by Ollama with custom tools.",
  "entry": "extension.ts",
  "capabilities": ["chat", "tools"],
  "tools": [
    {
      "name": "powershell.run",
      "description": "Run a PowerShell command",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string" }
        },
        "required": ["command"]
      }
    },
    {
      "name": "http.get",
      "description": "Fetch a URL via HTTP GET",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string" }
        },
        "required": ["url"]
      }
    },
    {
      "name": "fs.list",
      "description": "List files in a directory",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"]
      }
    }
  ]
}
